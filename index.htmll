841"}
<!DOCTYPE html>
<html>
<head>
  <title>Cardio OSPE</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
      background: #f4f6f9;
    }

    #container {
      position: relative;
      display: inline-block;
    }

    img {
      width: 90%;
      max-width: 600px;
      border-radius: 10px;
    }

    .spot {
      position: absolute;
      width: 18px;
      height: 18px;
      background: red;
      border-radius: 50%;
      cursor: pointer;
    }

    #question-box {
      margin-top: 20px;
      display: none;
    }

    button {
      margin: 5px;
      padding: 10px;
      width: 200px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }

    .correct { background: green; color: white; }
    .wrong { background: red; color: white; }
  </style>
</head>

<body>

<h2>Cardiovascular OSPE</h2>

<div id="container">
  <img src="capillary.jpg">

  <div class="spot" style="top:35%; left:50%;" onclick="ask(0)"></div>
  <div class="spot" style="top:60%; left:45%;" onclick="ask(1)"></div>
  <div class="spot" style="top:50%; left:70%;" onclick="ask(2)"></div>
</div>

<div id="question-box">
  <h3 id="question"></h3>
  <div id="answers"></div>
</div>

<h3 id="score"></h3>

<script>

const questions = [
{
q: "Identify this structure",
a: ["Endothelial cell","Pericyte","Lumen","Basal lamina"],
correct: 0
},
{
q: "Identify this structure",
a: ["Lumen","Collagen","Nucleus","Vesicle"],
correct: 0
},
{
q: "Identify this structure",
a: ["Pericyte","Neuron","Muscle","Fibroblast"],
correct: 0
}
];

let score = 0;
let current = 0;

function ask(i){
  current = i;
  document.getElementById("question-box").style.display = "block";
  document.getElementById("question").innerText = questions[i].q;

  let html = "";
  questions[i].a.forEach((opt,index)=>{
    html += <button onclick="answer(${index})">${opt}</button>;
  });

  document.getElementById("answers").innerHTML = html;
}

function answer(i){
  if(i === questions[current].correct){
    score++;
    document.getElementById("score").innerText = "Score: " + score;
  } else {
    alert("Wrong!");
  }
}

</script>

</body>
</
